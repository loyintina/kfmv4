{
  "name": "kfmv4",
  "version": "8.3.2",
  "description": "KFM v4 - TypeScript 全栈文件管理器",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/clean-npm-temp.cjs",
    "bundle": "node build.mjs",
    "watch": "node build.mjs && (sass --no-source-map --watch public/css/:public/css/ & npx esbuild src/client/main.ts --bundle --platform=browser --format=iife --outfile=public/bundle.js --target=es2019 --external:katex --external:mermaid --minify --watch)",
    "dev": "node build.mjs && npm run start",
    "check": "node scripts/check/chain.mjs",
    "sync-counts": "node scripts/check/sync-counts.mjs",
    "docs:status": "node scripts/check/docs-status.mjs",
    "build": "node build.mjs",
    "start": "kill $(lsof -t -i:8021) 2>/dev/null; node dist/server/index.js",
    "test": "npx tsx --import ./tests/register-hook.mjs --import ./tests/preload.mjs ./tests/regression.test.ts",
    "smoke": "node tests/smoke/smoke.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.6",
    "@oh-my-pi/pi-utils": "^16.4.2",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "compression": "^1.8.1",
    "express": "^4.22.1",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.5",
    "node-pty-prebuilt-multiarch": "^0.10.1-pre.5",
    "sass": "^1.100.0",
    "ts-node": "^10.9.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.0.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@vscode/debugadapter": "^1.68.0",
    "esbuild": "^0.28.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.2"
  }
}
