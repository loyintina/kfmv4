<?xml version="1.0" encoding="utf-8"?>
<!-- 8.8.6 壳层开屏主题（用户拍板「从 apk 壳层点击就播放动画」）：
     windowBackground=纯暗 #05070f——点击图标第一拍系统就画上它，盖住
     「进程创建+WebView 初始化」这段连渲染体都不存在的盲窗（约 0.2s）；
     动画开场本来就是暗场扫线，纯暗帧无缝衔接（曾用静态徽标帧，用户
     实拍定罪：徽标→暗场开场接不上=闪帧，2026-08-30 拍板改纯暗）。
     原 Fullscreen 主题其余语义不动。 -->
<resources>
    <color name="nz_bg">#05070F</color>
    <style name="NzSplashTheme" parent="android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/nz_bg</item>
        <!-- 全面屏 edge-to-edge（2026-08-31）：声明式刘海模式——窗口创建
             第一拍就生效（onCreate 里 setAttributes 是运行时补刀，两者
             都要；实测国产 ROM 对声明式更买账）。状态栏透明配合铺进。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
