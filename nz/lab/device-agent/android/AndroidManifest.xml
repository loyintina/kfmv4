<?xml version="1.0" encoding="utf-8"?>
<!-- nz 设备代理（device-agent）手工 manifest——复用 kfm-na package-apk.sh 同款
     零 Gradle 手工链（javac→d8→aapt2→zipalign→apksigner），无 Rust/.so，纯 Java 皮。

     选型定案（信箱 kfmv4-9.0-nz-device-agent-p1-response，2026-08-27 用户拍板）：
     P1 功能集 = WebView 加载 URL + 开调试 + CDP 中继线程，Java 原生支持，
     壳内零 Rust 活——不走 wry（其 Android 链要拖回 cargo-mobile2 + androidx
     AAR 世界，kfm-na 当年特意逃离的那条）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.kfm.nz.agent">

    <!-- WebView 加载 nz 终端（经 kalo 隧道 -L 8023，手机侧 127.0.0.1）+
         CDP 中继出站 127.0.0.1:8025/8028（同款隧道 -L） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 保活三件套（BAR-029 同款）：前台服务 + 通知 + 息屏 CPU 保活——
         退后台/息屏被 cached-app 冻结器冻住 = 心跳停跳、DIAL 黑洞 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 开机自启（只拉保活 Service，零 UI；用户拍板「加了也没关系」） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="NZ-Agent"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@style/NzSplashTheme">
        <!-- 主题=8.8.6 壳层开屏（res/values/styles.xml）：windowBackground
             =静态徽标帧盖住点击→WebView 初始化盲窗；原 Theme.DeviceDefault
             .NoActionBar.Fullscreen 语义由 parent 继承。 -->
        <!-- usesCleartextTraffic=true：targetSdk=28 起明文 HTTP 默认被禁，
             而 nz 终端是 http://127.0.0.1:8023/ 回环明文——不开这个 WebView
             直接拒载（net::ERR_CLEARTEXT_NOT_PERMITTED）。回环+隧道语境
             无真实明文暴露面。 -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale">
            <!-- configChanges 全集=国产 ROM 实锤坑对策（kfm-na 2026-08-13
                 android-activity#196：MIUI/OriginOS 启动注入 density/fontScale
                 变化触发 relaunch），一个都不许删。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".KeepAliveService"
            android:exported="false" />
        <!-- 开机自启 receiver：ACTION_BOOT_COMPLETED → startForegroundService
             （零 UI；观测常驻体随 Service 重建，实验台链路无人值守自愈） -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
