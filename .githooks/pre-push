#!/bin/sh
# KFM v4 — pre-push hook
# 在 git push 前运行 npm run check，确保文档-代码一致性
# 同时检查是否有未提交的改动
# 安装：git config core.hooksPath .githooks

echo "=== [pre-push] 检查未提交改动... ==="
cd "$(dirname "$0")/.." || exit 1

UNCOMMITTED=$(git status --porcelain | wc -l)
if [ "$UNCOMMITTED" -gt 0 ]; then
  echo "=== [pre-push] ⚠ 警告：有 ${UNCOMMITTED} 个未提交的改动 ==="
  echo "=== [pre-push] 未提交的改动在 git checkout 或会话中断时会永久丢失 ==="
  echo "=== [pre-push] 建议先 git add -A && git commit 后再 push ==="
  echo ""
  git status --short
  echo ""
fi

echo "=== [pre-push] 运行构建检查... ==="
npm run check
if [ $? -ne 0 ]; then
  echo "=== [pre-push] ❌ 检查失败，推送已阻止。请修复后重试。 ==="
  exit 1
fi

echo "=== [pre-push] ✅ 检查通过 ==="
